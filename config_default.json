{
  "vocab_size": 32000,
  "context_length": 256,
  "d_model": 512,
  "num_layers": 6,
  "num_heads": 8,
  "d_ff": 2048,
  "rope_theta": 10000,

  "lr": 0.0003,
  "beta1": 0.9,
  "beta2": 0.999,
  "eps": 1e-8,
  "weight_decay": 0.01,

  "batch_size": 32,
  "max_l2_norm": 1.0,
  "max_learning_rate": 1e-4,
  "min_learning_rate": 1e-5,
  "warmup_iters": 10,
  "cosine_cycle_iters": 600000,
  "max_steps": 1000000,
  
  "checkpoint_interval": 400,

  "train_data": "encode/owt_train.bin",
  "val_data": "encode/owt_valid.bin",

  "checkpoint_dir": "checkpoints",

  "device": "cpu",
  "use_wandb": true,
  "log_interval": 50
}
